# Required when binding to a network. Generate locally; do not commit the real key.
VIVA_CREATE_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Exact origin only, no trailing slash. Your hosting provider supplies the hostname.
VIVA_PUBLIC_ORIGIN=https://YOUR-DEPLOYED-HOST
VIVA_DB=/data/viva.sqlite
PORT=8765
# compose.yaml only: hostname without https://
VIVA_DOMAIN=YOUR-DEPLOYED-HOST

# Optional Vivo conversation backend. Leave OPENAI_API_KEY unset to keep the
# conversational capability honestly unavailable. Never put this in browser
# assets, GitHub Pages, Git, or a client URL.
# OPENAI_API_KEY=
VIVO_OPENAI_MODEL=gpt-6-luna
VIVO_CONVERSATION_TIMEOUT_SECONDS=18
VIVO_CONVERSATION_MAX_MESSAGE_CHARS=400
VIVO_CONVERSATION_MAX_OUTPUT_CHARS=4000
VIVO_OPENAI_MAX_OUTPUT_TOKENS=240
VIVO_CONVERSATION_REQUESTS_PER_MINUTE=12
