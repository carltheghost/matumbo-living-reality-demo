# Nonsecret shape only. Copy this to an untracked, secret-managed env file.
# Do not commit a real owner token or provider key.

# Caddy obtains the certificate for this DNS name. The origin passed to the
# Python authority must be this exact value: https:// + VIVA_DOMAIN, no path or
# trailing slash.
VIVA_DOMAIN=YOUR-REMOTE-HOST.example
VIVA_PUBLIC_ORIGIN=https://YOUR-REMOTE-HOST.example

# Internal backend TLS files. The backend certificate must contain the
# Docker service DNS name vivo-remote; Caddy trusts only the supplied CA.
VIVO_BACKEND_CERT_FILE=/secure/secret-store/vivo-backend.crt
VIVO_BACKEND_KEY_FILE=/secure/secret-store/vivo-backend.key
VIVO_BACKEND_CA_FILE=/secure/secret-store/vivo-backend-ca.pem

# Required remote capability. Generate/store it in the host's secret manager;
# the recipe never generates or persists it.
VIVO_OWNER_TOKEN=

# Optional conversation provider. Leave empty to keep Vivo conversation
# honestly unavailable. If enabled, inject the key only into this server.
OPENAI_API_KEY=
VIVO_OPENAI_MODEL=gpt-6-luna
VIVO_CONVERSATION_TIMEOUT_SECONDS=18
VIVO_CONVERSATION_MAX_MESSAGE_CHARS=400
VIVO_CONVERSATION_MAX_OUTPUT_CHARS=4000
VIVO_CONVERSATION_MAX_HISTORY_MESSAGES=24
VIVO_CONVERSATION_MAX_HISTORY_CHARS=12000
VIVO_OPENAI_MAX_OUTPUT_TOKENS=240
VIVO_CONVERSATION_REQUESTS_PER_MINUTE=12
VIVO_CONVERSATION_MAX_SESSIONS=256
VIVO_CONVERSATION_MAX_SESSIONS_PER_IDENTITY=32
VIVO_CONVERSATION_MAX_BODY_BYTES=16384
